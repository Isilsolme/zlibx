<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider paths, kept minimal: only the app's own download dir
     (external app files /Olib), its private files/cache, and caches.
     No public external-storage root: shared files must never expose
     anything outside what the app itself wrote. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="internal_files" path="."/>
    <cache-path name="cache_files" path="."/>
    <external-files-path name="external_app_files" path="Olib/"/>
    <external-cache-path name="external_cache_files" path="."/>
</paths>
